NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=

# Runtime connection used by the Next.js app. Use Supabase's TRANSACTION pooler (port 6543).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-us-east-2.pooler.supabase.com:6543/postgres

# Used ONLY by drizzle-kit (db:generate, db:migrate, db:studio). Use Supabase's
# SESSION pooler (port 5432). Same URL as DATABASE_URL but with :5432 instead of :6543.
# Required because PgBouncer transaction mode (6543) silently hangs on multi-statement DDL.
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-1-us-east-2.pooler.supabase.com:5432/postgres

CRON_SECRET=
VERCEL_API_TOKEN=

# API-SPORTS — single key powers football, basketball (NBA), American Football
# (NFL) and Formula 1 endpoints. Free plan: 100 req/day per API. Sign up at
# https://dashboard.api-sports.io (use direct path, NOT RapidAPI).
# ⚠️ Free tier is hard-locked to seasons 2022-2024 — not usable for current
# data. Dormant unless we ever upgrade to a paid plan (~$100/mo for All Sports).
API_SPORTS_KEY=

# football-data.org — Premier League, La Liga, Serie A, Bundesliga, Ligue 1,
# UCL, FIFA World Cup, Euro. Free: 10 req/min. Header: X-Auth-Token. Sign up at
# https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=

# BALLDONTLIE — NBA only on free tier (single-sport limit). 5 req/min.
# Header: Authorization (raw token, no "Bearer" prefix). Sign up: https://app.balldontlie.io
BALLDONTLIE_API_KEY=

# Padel API — Premier Padel + FIP tournaments, last 6 months of matches on free
# tier. 50K req/month. Header: Authorization: Bearer …. Base URL is
# https://padelapi.org/api (not the api. subdomain). https://padelapi.org
PADEL_API_KEY=

# Massive (formerly Polygon.io, rebranded early 2026) — prices the assets that
# back the investment methods: crypto, indices, stocks, ETFs and forex from one
# key. Free "Basic" tier per asset class: end-of-day data, 5 requests/minute,
# no card required. Sign up at https://massive.com and create a key.
#
# End-of-day suits the daily cron exactly — it wants yesterday's close, not a
# live tick.
#
# Licensed indices are 403 on the free tier (I:SPX among them), but the ETF
# that tracks the same index is not — use SPY for the S&P 500 and QQQ for the
# Nasdaq-100. I:NDX happens to be free; I:SPX is not.
#
# Sent as `Authorization: Bearer …`. The rebrand kept the API identical and both
# api.massive.com and the legacy api.polygon.io are live with the same keys; we
# use the former. MASSIVE_API_BASE_URL switches hosts without a code change.
MASSIVE_API_KEY=
# MASSIVE_API_BASE_URL=https://api.polygon.io

# Whether the app accepts new accounts. FAIL-CLOSED: anything other than the
# literal "true" (unset, empty, a typo) means signups are OFF.
#
# This gates the app: /signup renders a closed notice, the login page drops its
# sign-up link, and the OAuth callback rejects an account created by that very
# login. It does NOT gate Supabase — signup runs in the browser with the
# publishable key, so also switch OFF
# Dashboard -> Authentication -> Sign In / Providers -> "Allow new users to sign up".
ALLOW_SIGNUPS=false

# F1 news — RapidAPI "f1-motorsport-data". The daily cron pulls the provider's
# rolling window of 25 articles into `f1_news`; unset just means no refresh,
# the stored archive still reads. https://rapidapi.com
RAPIDAPI_KEY=
